generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql"; url = env("DATABASE_URL") }

enum EntityState { ACTIVE ARCHIVED CANCELLED VOID }
enum RequestStatus { NEW PRICING QUOTATION_SENT WAITING_CUSTOMER WAITING_SUPPLIER WAITING_INTERNAL WAITING_DOCUMENT ACTIVE PARTIALLY_COMPLETED COMPLETED REJECTED CANCELLED }
enum QuotationStatus { DRAFT SENT VIEWED ACCEPTED REJECTED EXPIRED }
enum OrderStatus { DRAFT CONFIRMED PARTIALLY_RECEIVED RECEIVED PARTIALLY_DELIVERED DELIVERED CANCELLED }
enum InvoiceDirection { INCOMING OUTGOING }
enum InvoiceStatus { DRAFT CONFIRMED PARTIAL PAID VOID }
enum MovementType { IN OUT TRANSFER ADJUSTMENT RETURN_IN RETURN_OUT }
enum AllocationMethod { FIFO MANUAL AVERAGE }
enum PaymentStatus { PENDING PARTIAL PAID OVERDUE VOID }
enum DocumentType { CONTRACT PRICE_AGREEMENT QUOTATION INVOICE DELIVERY_NOTE RECEIPT OTHER }
enum ImportStatus { UPLOADED PARSING REVIEW_REQUIRED CONFIRMED FAILED }
enum AuditAction { CREATE UPDATE DELETE LOGIN LOGOUT FAILED_LOGIN APPROVE REJECT UPLOAD DOWNLOAD IMPORT EXPORT STATUS_CHANGE PRICE_CHANGE STOCK_IN STOCK_OUT PERMISSION_DENIED }

model User { id String @id @default(cuid()); name String; email String @unique; passwordHash String?; active Boolean @default(true); roles UserRole[]; requests Request[] @relation("RequestOwner"); audits AuditLog[]; securityEvents SecurityLog[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Role { id String @id @default(cuid()); code String @unique; name String; users UserRole[]; permissions RolePermission[] }
model Permission { id String @id @default(cuid()); code String @unique; name String; roles RolePermission[] }
model UserRole { userId String; roleId String; user User @relation(fields:[userId],references:[id],onDelete:Restrict); role Role @relation(fields:[roleId],references:[id],onDelete:Restrict); @@id([userId,roleId]) }
model RolePermission { roleId String; permissionId String; role Role @relation(fields:[roleId],references:[id],onDelete:Restrict); permission Permission @relation(fields:[permissionId],references:[id],onDelete:Restrict); @@id([roleId,permissionId]) }

model Customer { id String @id @default(cuid()); companyName String; taxId String? @unique; address String?; phone String?; email String?; website String?; contactPerson String?; notes String?; state EntityState @default(ACTIVE); requests Request[]; quotations Quotation[]; salesOrders SalesOrder[]; outgoingInvoices Invoice[] @relation("InvoiceCustomer"); payments Payment[] @relation("PaymentCustomer"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([companyName]) }
model Supplier { id String @id @default(cuid()); companyName String; taxId String? @unique; address String?; phone String?; email String?; contactPerson String?; paymentTerms String?; deliveryTime Int?; notes String?; state EntityState @default(ACTIVE); products SupplierProduct[]; purchaseOrders PurchaseOrder[]; incomingInvoices Invoice[] @relation("InvoiceSupplier"); lots StockLot[]; payments Payment[] @relation("PaymentSupplier"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([companyName]) }
model ProductCategory { id String @id @default(cuid()); name String @unique; products Product[] }
model Unit { id String @id @default(cuid()); code String @unique; name String; symbol String; products Product[] @relation("DefaultUnit"); productUnits ProductUnit[]; requestItems RequestItem[]; quotationItems QuotationItem[]; poItems PurchaseOrderItem[]; salesItems SalesOrderItem[]; invoiceItems InvoiceItem[] }
model Product { id String @id @default(cuid()); sku String @unique; name String; description String?; categoryId String?; category ProductCategory? @relation(fields:[categoryId],references:[id],onDelete:SetNull); defaultUnitId String; defaultUnit Unit @relation("DefaultUnit",fields:[defaultUnitId],references:[id]); minimumStock Decimal @default(0) @db.Decimal(18,3); maximumStock Decimal? @db.Decimal(18,3); active Boolean @default(true); units ProductUnit[]; suppliers SupplierProduct[]; requestItems RequestItem[]; lots StockLot[]; movements StockMovement[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([sku]); @@index([categoryId]) }
model ProductUnit { id String @id @default(cuid()); productId String; unitId String; conversionFactor Decimal @db.Decimal(18,6); product Product @relation(fields:[productId],references:[id],onDelete:Cascade); unit Unit @relation(fields:[unitId],references:[id],onDelete:Restrict); @@unique([productId,unitId]) }
model SupplierProduct { id String @id @default(cuid()); supplierId String; productId String; supplierSku String?; purchasePrice Decimal? @db.Decimal(18,4); currency String @default("AZN"); lastPrice Decimal? @db.Decimal(18,4); averagePrice Decimal? @db.Decimal(18,4); leadTime Int?; minimumOrder Decimal? @db.Decimal(18,3); notes String?; supplier Supplier @relation(fields:[supplierId],references:[id],onDelete:Restrict); product Product @relation(fields:[productId],references:[id],onDelete:Restrict); priceHistory SupplierPriceHistory[]; @@unique([supplierId,productId]) }
model SupplierPriceHistory { id String @id @default(cuid()); supplierProductId String; price Decimal @db.Decimal(18,4); currency String; capturedAt DateTime @default(now()); supplierProduct SupplierProduct @relation(fields:[supplierProductId],references:[id],onDelete:Cascade) }

model Request { id String @id @default(cuid()); number String @unique; customerId String; date DateTime @default(now()); deadline DateTime?; priority String @default("NORMAL"); responsibleId String?; status RequestStatus @default(NEW); waitingReason String?; rejectionReason String?; rejectionNote String?; notes String?; state EntityState @default(ACTIVE); customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict); responsible User? @relation("RequestOwner",fields:[responsibleId],references:[id],onDelete:SetNull); items RequestItem[]; history RequestStatusHistory[]; quotations Quotation[]; purchaseOrders PurchaseOrder[]; salesOrders SalesOrder[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; @@index([number]); @@index([customerId,status]); @@index([status,createdAt]) }
model RequestItem { id String @id @default(cuid()); requestId String; productId String?; productNameSnapshot String; quantity Decimal @db.Decimal(18,3); unitId String; purchasePrice Decimal? @db.Decimal(18,4); salePrice Decimal? @db.Decimal(18,4); supplierId String?; profit Decimal? @db.Decimal(18,4); status String @default("OPEN"); notes String?; addedById String?; addedAt DateTime @default(now()); request Request @relation(fields:[requestId],references:[id],onDelete:Restrict); product Product? @relation(fields:[productId],references:[id],onDelete:SetNull); unit Unit @relation(fields:[unitId],references:[id],onDelete:Restrict) }
model RequestStatusHistory { id String @id @default(cuid()); requestId String; fromStatus RequestStatus?; toStatus RequestStatus; reason String?; changedById String?; createdAt DateTime @default(now()); request Request @relation(fields:[requestId],references:[id],onDelete:Restrict); @@index([requestId,createdAt]) }
model Quotation { id String @id @default(cuid()); number String @unique; requestId String; customerId String; version Int @default(1); date DateTime @default(now()); validUntil DateTime?; status QuotationStatus @default(DRAFT); subtotal Decimal @default(0) @db.Decimal(18,2); tax Decimal @default(0) @db.Decimal(18,2); discount Decimal @default(0) @db.Decimal(18,2); total Decimal @default(0) @db.Decimal(18,2); currency String @default("AZN"); request Request @relation(fields:[requestId],references:[id],onDelete:Restrict); customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict); items QuotationItem[]; salesOrder SalesOrder?; createdAt DateTime @default(now()); @@unique([requestId,version]); @@index([number]) }
model QuotationItem { id String @id @default(cuid()); quotationId String; productId String?; description String; quantity Decimal @db.Decimal(18,3); unitId String; unitPrice Decimal @db.Decimal(18,4); total Decimal @db.Decimal(18,2); quotation Quotation @relation(fields:[quotationId],references:[id],onDelete:Restrict); unit Unit @relation(fields:[unitId],references:[id],onDelete:Restrict) }
model PurchaseOrder { id String @id @default(cuid()); number String @unique; supplierId String; requestId String?; date DateTime @default(now()); expectedDelivery DateTime?; status OrderStatus @default(DRAFT); total Decimal @default(0) @db.Decimal(18,2); state EntityState @default(ACTIVE); supplier Supplier @relation(fields:[supplierId],references:[id],onDelete:Restrict); request Request? @relation(fields:[requestId],references:[id],onDelete:SetNull); items PurchaseOrderItem[]; invoices Invoice[]; @@index([number]); @@index([supplierId,status]) }
model PurchaseOrderItem { id String @id @default(cuid()); purchaseOrderId String; productId String?; description String; quantity Decimal @db.Decimal(18,3); unitId String; unitPrice Decimal @db.Decimal(18,4); total Decimal @db.Decimal(18,2); purchaseOrder PurchaseOrder @relation(fields:[purchaseOrderId],references:[id],onDelete:Restrict); unit Unit @relation(fields:[unitId],references:[id],onDelete:Restrict) }
model SalesOrder { id String @id @default(cuid()); number String @unique; customerId String; requestId String?; quotationId String? @unique; date DateTime @default(now()); status OrderStatus @default(DRAFT); total Decimal @default(0) @db.Decimal(18,2); state EntityState @default(ACTIVE); customer Customer @relation(fields:[customerId],references:[id],onDelete:Restrict); request Request? @relation(fields:[requestId],references:[id],onDelete:SetNull); quotation Quotation? @relation(fields:[quotationId],references:[id],onDelete:SetNull); items SalesOrderItem[]; invoices Invoice[]; deliveries Delivery[]; @@index([number]); @@index([customerId,status]) }
model SalesOrderItem { id String @id @default(cuid()); salesOrderId String; productId String?; description String; quantity Decimal @db.Decimal(18,3); unitId String; salePrice Decimal @db.Decimal(18,4); total Decimal @db.Decimal(18,2); cost Decimal? @db.Decimal(18,4); profit Decimal? @db.Decimal(18,2); salesOrder SalesOrder @relation(fields:[salesOrderId],references:[id],onDelete:Restrict); unit Unit @relation(fields:[unitId],references:[id],onDelete:Restrict) }

model Warehouse { id String @id @default(cuid()); code String @unique; name String; address String?; lots StockLot[]; movements StockMovement[]; invoices Invoice[]; deliveries Delivery[] }
model StockLot { id String @id @default(cuid()); number String @unique; productId String; warehouseId String; supplierId String?; goodsReceiptId String?; quantityReceived Decimal @db.Decimal(18,3); quantityRemaining Decimal @db.Decimal(18,3); purchasePrice Decimal @db.Decimal(18,4); receivedDate DateTime @default(now()); product Product @relation(fields:[productId],references:[id],onDelete:Restrict); warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete:Restrict); supplier Supplier? @relation(fields:[supplierId],references:[id],onDelete:SetNull); allocations StockAllocation[]; @@index([productId,warehouseId,receivedDate]) }
model StockMovement { id String @id @default(cuid()); warehouseId String; productId String; type MovementType; quantity Decimal @db.Decimal(18,3); referenceType String; referenceId String; userId String?; occurredAt DateTime @default(now()); warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete:Restrict); product Product @relation(fields:[productId],references:[id],onDelete:Restrict); allocations StockAllocation[]; @@index([productId,warehouseId,occurredAt]); @@index([referenceType,referenceId]) }
model StockAllocation { id String @id @default(cuid()); stockLotId String; stockMovementId String; quantity Decimal @db.Decimal(18,3); unitCost Decimal @db.Decimal(18,4); stockLot StockLot @relation(fields:[stockLotId],references:[id],onDelete:Restrict); stockMovement StockMovement @relation(fields:[stockMovementId],references:[id],onDelete:Restrict); @@unique([stockLotId,stockMovementId]) }
model GoodsReceipt { id String @id @default(cuid()); number String @unique; purchaseOrderId String?; warehouseId String; date DateTime @default(now()); items GoodsReceiptItem[] }
model GoodsReceiptItem { id String @id @default(cuid()); goodsReceiptId String; productId String; quantity Decimal @db.Decimal(18,3); unitPrice Decimal @db.Decimal(18,4); goodsReceipt GoodsReceipt @relation(fields:[goodsReceiptId],references:[id],onDelete:Restrict) }
model Delivery { id String @id @default(cuid()); number String @unique; salesOrderId String; warehouseId String; date DateTime @default(now()); salesOrder SalesOrder @relation(fields:[salesOrderId],references:[id],onDelete:Restrict); warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete:Restrict); items DeliveryItem[] }
model DeliveryItem { id String @id @default(cuid()); deliveryId String; productId String; quantity Decimal @db.Decimal(18,3); delivery Delivery @relation(fields:[deliveryId],references:[id],onDelete:Restrict) }
model Invoice { id String @id @default(cuid()); number String @unique; direction InvoiceDirection; supplierId String?; customerId String?; purchaseOrderId String?; salesOrderId String?; warehouseId String; date DateTime @default(now()); total Decimal @default(0) @db.Decimal(18,2); tax Decimal @default(0) @db.Decimal(18,2); currency String @default("AZN"); status InvoiceStatus @default(DRAFT); state EntityState @default(ACTIVE); supplier Supplier? @relation("InvoiceSupplier",fields:[supplierId],references:[id],onDelete:SetNull); customer Customer? @relation("InvoiceCustomer",fields:[customerId],references:[id],onDelete:SetNull); purchaseOrder PurchaseOrder? @relation(fields:[purchaseOrderId],references:[id],onDelete:SetNull); salesOrder SalesOrder? @relation(fields:[salesOrderId],references:[id],onDelete:SetNull); warehouse Warehouse @relation(fields:[warehouseId],references:[id],onDelete:Restrict); items InvoiceItem[]; payments Payment[]; @@index([number]); @@index([direction,status]) }
model InvoiceItem { id String @id @default(cuid()); invoiceId String; productId String?; description String; quantity Decimal @db.Decimal(18,3); unitId String; unitPrice Decimal @db.Decimal(18,4); total Decimal @db.Decimal(18,2); invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict); unit Unit @relation(fields:[unitId],references:[id],onDelete:Restrict) }
model Payment { id String @id @default(cuid()); customerId String?; supplierId String?; invoiceId String; amount Decimal @db.Decimal(18,2); currency String @default("AZN"); paymentDate DateTime @default(now()); method String; status PaymentStatus @default(PENDING); note String?; customer Customer? @relation("PaymentCustomer",fields:[customerId],references:[id],onDelete:SetNull); supplier Supplier? @relation("PaymentSupplier",fields:[supplierId],references:[id],onDelete:SetNull); invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Restrict); @@index([invoiceId,status]) }

model Document { id String @id @default(cuid()); filename String; type DocumentType; storageKey String; mimeType String; size Int; uploadedById String?; uploadedAt DateTime @default(now()); links DocumentLink[] }
model DocumentLink { id String @id @default(cuid()); documentId String; entityType String; entityId String; document Document @relation(fields:[documentId],references:[id],onDelete:Cascade); @@unique([documentId,entityType,entityId]); @@index([entityType,entityId]) }
model ImportJob { id String @id @default(cuid()); documentId String?; status ImportStatus @default(UPLOADED); sourceType String; createdById String?; confidence Decimal? @db.Decimal(5,2); extracted ExtractedData[]; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model ExtractedData { id String @id @default(cuid()); importJobId String; field String; value Json; confidence Decimal @db.Decimal(5,2); confirmed Boolean @default(false); importJob ImportJob @relation(fields:[importJobId],references:[id],onDelete:Cascade) }
model Notification { id String @id @default(cuid()); userId String?; type String; title String; body String; readAt DateTime?; entityType String?; entityId String?; createdAt DateTime @default(now()); @@index([userId,readAt]) }
model AuditLog { id String @id @default(cuid()); userId String?; action AuditAction; module String; entityType String; entityId String; oldData Json?; newData Json?; ip String?; userAgent String?; createdAt DateTime @default(now()); user User? @relation(fields:[userId],references:[id],onDelete:SetNull); @@index([entityType,entityId,createdAt]); @@index([createdAt]) }
model SecurityLog { id String @id @default(cuid()); userId String?; event String; ip String?; device String?; browser String?; success Boolean; createdAt DateTime @default(now()); user User? @relation(fields:[userId],references:[id],onDelete:SetNull); @@index([userId,createdAt]) }
