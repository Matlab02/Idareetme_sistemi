  <meta name="ProgId" content="Excel.Sheet">
  <style>
    table { border-collapse: collapse; font-family: Arial, sans-serif; }
    th, td { border: 1px solid #b8c4d6; padding: 7px 10px; }
    th { background: #eaf2ff; font-weight: 700; }
