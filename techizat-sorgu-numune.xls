</head>
<body>
  <table>
    <tr><th>Məhsul kodu</th><th>Məhsul adı</th><th>Xüsusiyyət 1</th><th>Xüsusiyyət 2</th><th>Material / Rəng</th><th>Miqdar</th><th>Vahid</th><th>Qeyd</th><th>Alış qiyməti</th><th>Satış qiyməti</th></tr>
  </table>
</body>
</html>
